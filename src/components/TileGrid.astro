---
import { collectionSurfaceStyle, type BrowseTile, type FacetKey } from "../lib/catalog";

interface Props {
    tiles: BrowseTile[];
    mode: "tiles" | "list";
    facet?: FacetKey;
}

const { tiles, mode, facet } = Astro.props;
---

{
    mode === "tiles" ? (
        <div
            class:list={[
                "tile-grid grid grid-cols-2 gap-2.5 md:grid-cols-3 md:gap-3 lg:grid-cols-4",
                facet === "featured" && "tile-grid-featured",
                (facet === "genre" || facet === "occasion") && "tile-grid-genre",
            ]}
        >
            {tiles.map((tile) => (
                <a
                    href={tile.href}
                    class:list={[
                        "collection-tile flex items-end overflow-hidden rounded-xl p-3.5 no-underline",
                        facet === "featured"
                            ? "h-24 md:h-full md:p-4 lg:p-5"
                            : ["h-24", tile.large ? "md:h-32 lg:h-36" : "md:h-28 lg:h-28"],
                        tile.art && "has-art",
                    ]}
                    style={collectionSurfaceStyle(tile)}
                    data-vt-chrome={tile.transitionName}
                    transition:name={tile.transitionName}
                    transition:animate="initial"
                >
                    <span
                        class:list={[
                            "collection-tile-label text-left font-bold tracking-tight",
                            tile.large ? "text-[30px] tracking-[-0.02em]" : "text-[18px] leading-tight",
                        ]}
                        style={tile.art ? undefined : `color:${tile.ink ?? "#F7F2E9"}`}
                        data-vt-title={tile.titleTransitionName}
                        transition:name={tile.titleTransitionName}
                        transition:animate="initial"
                    >
                        {tile.label}
                    </span>
                </a>
            ))}
        </div>
    ) : (
        <div class="flex flex-col gap-px md:grid md:grid-cols-2 md:gap-x-10">
            {/* Named chrome on the row so the title nests the same way as the collection bar. */}
            {tiles.map((tile) => (
                <a
                    href={tile.href}
                    class="collection-tile flex w-full items-center gap-3 border-b border-line px-0.5 py-4 text-left no-underline"
                    data-vt-chrome={tile.transitionName}
                    transition:name={tile.transitionName}
                    transition:animate="initial"
                >
                    <span
                        class="collection-tile-label flex-1 text-base text-cream"
                        data-vt-title={tile.titleTransitionName}
                        transition:name={tile.titleTransitionName}
                        transition:animate="initial"
                    >
                        {tile.label}
                    </span>
                    <span class="row-chevron text-[15px] text-dim md:hidden" aria-hidden="true">
                        →
                    </span>
                </a>
            ))}
        </div>
    )
}
