---
import BrandMark from "./BrandMark.astro";
import FavoritesNav from "./FavoritesNav.astro";
import FacetTabs from "./FacetTabs.astro";
import SearchInput from "./SearchInput.astro";
import { FACETS, type FacetKey } from "../lib/catalog";

interface Props {
    /** Browse facet. Omit on /search so the field stays in the same place. */
    facet?: FacetKey;
}

const { facet } = Astro.props;
const searchPage = facet === undefined;
const inputId = "catalog-search-input";
const heading = searchPage
    ? "Search"
    : facet === "featured"
      ? "kkaraoke"
      : (FACETS.find((f) => f.key === facet)?.label ?? "Browse");

// iOS Safari paints the caret from the rect at focus. The persisted input
// keeps keyboard, but the overlay does not follow a layout move — so browse
// and /search share this header's field offset.
---

<header class="browse-header border-b border-line" transition:animate="none">
    <div class="page-inner browse-header-inner">
        <h1 class="sr-only">{heading}</h1>
        <div class="browse-brand">
            <BrandMark current={facet === "featured"} />
        </div>
        {
            !searchPage && (
                <div class="browse-tools">
                    <FavoritesNav />
                </div>
            )
        }
        <div class="browse-search">
            <search class="min-w-0 flex-1" data-search-launch={searchPage ? undefined : true}>
                <label
                    class="search-field flex w-full cursor-text items-center gap-2.5 rounded-xl border border-line-strong bg-panel px-3.5 py-3.5 text-left md:py-2.5"
                    for={inputId}
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="17"
                        height="17"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        aria-hidden="true"
                        class="pointer-events-none text-muted"
                        ><circle cx="11" cy="11" r="7"></circle><path d="M16.5 16.5 21 21"></path></svg
                    >
                    <SearchInput id={inputId} autofocus={searchPage} />
                </label>
            </search>
            {
                searchPage && (
                    <a
                        href="/"
                        data-smart-back
                        data-search-cancel
                        class="bg-transparent px-1 py-1 text-base text-muted no-underline hover:text-cream-soft"
                    >
                        Cancel
                    </a>
                )
            }
        </div>
        {
            !searchPage && facet && (
                <div class="browse-tabs">
                    <FacetTabs active={facet} />
                </div>
            )
        }
    </div>
</header>
