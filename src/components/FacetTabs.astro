---
import { FACETS, type FacetKey } from "../lib/catalogue";

interface Props {
    active: FacetKey;
}

const { active } = Astro.props;
---

<nav aria-label="Browse catalogue" data-facet-tabs class="hd mt-3 flex scroll-px-3 gap-1.5 overflow-x-auto">
    {
        FACETS.map((facet) => (
            <a
                href={facet.href}
                data-facet={facet.key}
                aria-current={facet.key === active ? "page" : undefined}
                class:list={[
                    "shrink-0 rounded-full border px-3.5 py-2 text-[13.5px] font-semibold no-underline",
                    facet.key === active
                        ? "border-[#F2EDE4] bg-[#F2EDE4] text-[#14120F] hover:text-[#14120F]"
                        : "border-[#2A2724] bg-[#1A1917] text-[#9A9086] hover:text-[#C6BDB1]",
                ]}
            >
                {facet.label}
            </a>
        ))
    }
</nav>
