---
import { FACETS, type FacetKey } from "../lib/catalog";

interface Props {
    active: FacetKey;
}

const { active } = Astro.props;
---

<nav aria-label="Browse catalog" data-facet-tabs class="hd mt-3 flex scroll-px-3 gap-1.5 overflow-x-auto">
    {
        FACETS.map((facet) => (
            <a
                href={facet.href}
                data-facet={facet.key}
                aria-current={facet.key === active ? "page" : undefined}
                class:list={[
                    "shrink-0 rounded-full border px-3.5 py-2 text-[13.5px] font-semibold no-underline",
                    facet.key === active
                        ? "border-cream bg-cream text-ink hover:text-ink"
                        : "border-line-strong bg-panel text-muted hover:text-cream-soft",
                ]}
            >
                {facet.label}
            </a>
        ))
    }
</nav>
