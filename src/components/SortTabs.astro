<div class="hd flex gap-1.5 overflow-x-auto px-[18px] pb-4" data-sort-tabs role="group" aria-label="Sort songs">
    {
        [
            { key: "az", label: "A–Z" },
            { key: "artist", label: "By artist" },
            { key: "year", label: "By year" },
        ].map((tab, i) => (
            <button
                type="button"
                data-sort={tab.key}
                aria-pressed={i === 0 ? "true" : "false"}
                class:list={[
                    "shrink-0 rounded-full border border-white/18 px-3.5 py-1.5 text-[13px] font-semibold",
                    i === 0 ? "bg-white/92 text-[#17150F]" : "bg-black/22 text-white/85",
                ]}
            >
                {tab.label}
            </button>
        ))
    }
</div>
