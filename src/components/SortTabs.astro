<div class="hd flex gap-1.5 overflow-x-auto pb-4" data-sort-tabs role="group" aria-label="Sort songs">
    {
        [
            { key: "az", label: "A–Z" },
            { key: "artist", label: "By artist" },
            { key: "year", label: "By year" },
        ].map((tab, i) => (
            <button
                type="button"
                data-sort={tab.key}
                aria-pressed={i === 0 ? "true" : "false"}
                class="sort-tab shrink-0 rounded-full px-3.5 py-1.5 text-[13px] font-semibold"
            >
                {tab.label}
            </button>
        ))
    }
</div>
