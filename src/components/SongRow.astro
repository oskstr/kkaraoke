---
interface Props {
    songId: number;
    title: string;
    subtitle: string;
    href?: string;
    /** When true, title is not a link (artist page). */
    staticTitle?: boolean;
    titleAttr?: string;
    artistAttr?: string;
    yearAttr?: string;
}

const { songId, title, subtitle, href, staticTitle = false, titleAttr, artistAttr, yearAttr } =
    Astro.props;
---

<div
    class="song-row flex items-center gap-2.5 border-b border-line py-3"
    data-title={titleAttr ?? title}
    data-artist={artistAttr ?? ""}
    data-year={yearAttr ?? ""}
>
    {
        staticTitle || !href ? (
            <div class="flex min-h-11 flex-1 flex-col justify-center">
                <div class="text-[15.5px] leading-snug text-cream">{title}</div>
                {subtitle && <div class="mt-0.5 text-[13px] text-muted">{subtitle}</div>}
            </div>
        ) : (
            <a href={href} class="flex min-h-11 flex-1 flex-col justify-center text-left no-underline">
                <div class="text-[15.5px] leading-snug text-cream">{title}</div>
                {subtitle && <div class="mt-0.5 text-[13px] text-muted">{subtitle}</div>}
            </a>
        )
    }
    <button
        type="button"
        data-fav-toggle={songId}
        class="min-w-11 bg-transparent px-1 py-2.5 text-[17px]"
        style="border:0;color:#3B3733"
        aria-label="Add to favorites"
        aria-pressed="false"
    >
        ♥
    </button>
</div>
