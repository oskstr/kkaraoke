---
import type { CreditedArtist } from "../lib/songs";

interface Props {
    songId: number;
    title: string;
    /** Plain subtitle when not linking individual artists (e.g. artist page meta). */
    subtitle?: string;
    artists?: CreditedArtist[];
    from?: string;
    year?: number;
    category?: string;
    /** When true, don't link artist names (already on an artist page). */
    hideArtistLink?: boolean;
    titleAttr?: string;
    artistAttr?: string;
    yearAttr?: string;
}

const {
    songId,
    title,
    subtitle,
    artists = [],
    from,
    year,
    category,
    hideArtistLink = false,
    titleAttr,
    artistAttr,
    yearAttr,
} = Astro.props;

const metaBits = [from, year !== undefined ? String(year) : null].filter(Boolean);
---

<div
    class="song-row flex items-center gap-2.5 border-b border-line py-3"
    data-title={titleAttr ?? title}
    data-artist={artistAttr ?? ""}
    data-year={yearAttr ?? ""}
    data-id={String(songId)}
>
    <span
        class="song-num w-11 shrink-0 text-right font-mono text-[12px] tabular-nums leading-none text-gold"
        aria-label={`Number ${songId}`}
    >
        {songId}
    </span>
    <div class="flex min-h-11 flex-1 flex-col justify-center">
        <div class="text-[15.5px] leading-snug text-cream">{title}</div>
        <div class="mt-0.5 text-[13px] text-muted">
            {
                hideArtistLink ? (
                    subtitle
                ) : artists.length > 0 ? (
                    <>
                        {artists.map((artist, index) => (
                            <>
                                {index > 0 && <span>, </span>}
                                <a
                                    href={`/artists/${artist.slug}`}
                                    class="text-muted no-underline hover:text-cream-soft"
                                >
                                    {artist.name}
                                </a>
                            </>
                        ))}
                        {metaBits.length > 0 && <span> · {metaBits.join(" · ")}</span>}
                    </>
                ) : (
                    <>
                        {category && <span>{category}</span>}
                        {category && metaBits.length > 0 && <span> · </span>}
                        {metaBits.length > 0 && <span>{metaBits.join(" · ")}</span>}
                        {!category && metaBits.length === 0 && subtitle}
                    </>
                )
            }
        </div>
    </div>
    <button
        type="button"
        data-fav-toggle={songId}
        class="min-w-11 bg-transparent px-1 py-2.5 text-[17px]"
        style="border:0;color:#3B3733"
        aria-label="Add to favorites"
        aria-pressed="false"
    >
        ♥
    </button>
</div>
