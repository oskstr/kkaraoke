---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { DEFAULT_THEME_COLOR, LIGHT_THEME_COLOR, SITE_DESCRIPTION } from "../lib/catalog";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    /** Site-relative share image; collection pages pass their still. */
    image?: string;
    imageAlt?: string;
}

const { title, description = SITE_DESCRIPTION, image = "/og.png", imageAlt = "kkaraoke" } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const shareImage = new URL(image, Astro.site ?? Astro.url).href;
const shareType = image.endsWith(".jpg") || image.endsWith(".jpeg") ? "image/jpeg" : "image/png";
---

<!doctype html>
<html lang="en" transition:name="root">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="color-scheme" content="light dark" />
        <!--
          Media-queried theme-color follows the OS, matching the CSS palette.
          Still not per-page: a ClientRouter swap of these tags freezes a solid
          bar and flashes. iOS dark-mode ignores the tag and samples the page.
        -->
        <meta name="theme-color" content={DEFAULT_THEME_COLOR} media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content={LIGHT_THEME_COLOR} media="(prefers-color-scheme: light)" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <!-- iOS Messages ignores SVG favicons; this PNG is what replaces the compass placeholder. -->
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="apple-mobile-web-app-title" content="kkaraoke" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:site_name" content="kkaraoke" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content="en" />
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:alt" content={imageAlt} />
        <meta property="og:image:type" content={shareType} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={shareImage} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <Font cssVariable="--font-archivo" preload />
        <Font cssVariable="--font-dm-mono" />
        <title>{title}</title>
        <!--
          ClientRouter restores window scroll on history back by default.
          Keep the page on document scroll (no overflow phone-shell scroller)
          so that built-in behavior works.
        -->
        <ClientRouter />
    </head>
    <body>
        <a href="#main" class="skip-link">Skip to content</a>
        <div
            class="app-shell mx-auto min-h-dvh w-full max-w-md bg-surface text-cream sm:my-6 sm:min-h-[min(844px,calc(100dvh-3rem))] sm:rounded-[30px] sm:border sm:border-line-strong"
        >
            <slot />
        </div>
        <script>
            import "../scripts/favorites.ts";
            import "../scripts/navigation.ts";
            import "../scripts/song-window.ts";
            void import("../lib/search-index.ts").then((m) => {
                if (location.pathname === "/" || location.pathname.startsWith("/browse")) {
                    void m.getSearchIndex().catch(() => {});
                }
            });
        </script>
    </body>
</html>
