---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { DEFAULT_THEME_COLOR } from "../lib/catalogue";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Browse the karaoke catalogue by artist, decade, genre, and more." } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="en" transition:animate="fade">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="color-scheme" content="dark" />
        <!--
          Bare theme-color (no media query): Android chrome. iOS dark-mode ignores
          this and samples the page — which is what we want, including during
          view transitions. A media-queried / per-page tag freezes a solid bar
          and flashes when ClientRouter updates it.
        -->
        <meta name="theme-color" content={DEFAULT_THEME_COLOR} />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="canonical" href={canonical} />
        <Font cssVariable="--font-archivo" preload />
        <Font cssVariable="--font-dm-mono" />
        <title>{title}</title>
        <!--
          ClientRouter restores window scroll on history back by default.
          Keep the page on document scroll (no overflow phone-shell scroller)
          so that built-in behavior works.
        -->
        <ClientRouter />
    </head>
    <body>
        <a href="#main" class="skip-link">Skip to content</a>
        <div
            class="app-shell mx-auto min-h-dvh w-full max-w-md bg-surface text-cream shadow-[0_30px_70px_rgba(0,0,0,0.55)] sm:my-6 sm:min-h-[min(844px,calc(100dvh-3rem))] sm:rounded-[30px] sm:border sm:border-line-strong"
            transition:name="app-shell"
            transition:animate="initial"
        >
            <slot />
        </div>
        <script>
            import "../scripts/favorites.ts";
            import "../scripts/navigation.ts";
            import "../scripts/song-window.ts";
            void import("../lib/search-index.ts").then((m) => {
                if (location.pathname === "/" || location.pathname.startsWith("/browse")) {
                    void m.getSearchIndex().catch(() => {});
                }
            });
        </script>
    </body>
</html>
