---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Browse the karaoke catalogue by artist, decade, genre, and more." } =
    Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="fade">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
        <!--
          ClientRouter restores window scroll on history back by default.
          Keep the page on document scroll (no overflow phone-shell scroller)
          so that built-in behavior works.
        -->
        <ClientRouter />
    </head>
    <body>
        <div
            class="app-shell mx-auto min-h-dvh w-full max-w-md bg-surface text-cream shadow-[0_30px_70px_rgba(0,0,0,0.55)] sm:my-6 sm:min-h-[min(844px,calc(100dvh-3rem))] sm:rounded-[30px] sm:border sm:border-line-strong"
            transition:name="app-shell"
            transition:animate="initial"
        >
            <slot />
        </div>
        <script>
            import "../scripts/favorites.ts";
            import "../scripts/navigation.ts";
            import "../scripts/song-window.ts";
            void import("../lib/search-index.ts").then((m) => {
                if (location.pathname === "/" || location.pathname.startsWith("/browse")) {
                    void m.getSearchIndex().catch(() => {});
                }
            });
        </script>
    </body>
</html>
