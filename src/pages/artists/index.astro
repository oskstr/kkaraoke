---
import Layout from "../../layouts/Layout.astro";
import BrandMark from "../../components/BrandMark.astro";
import DesktopAppBar from "../../components/DesktopAppBar.astro";
import { artistSongCounts, groupArtists } from "../../lib/catalog";
import { getArtists, getSongs } from "../../lib/songs";

const groups = groupArtists(getArtists());
const counts = artistSongCounts(getSongs());
---

<Layout title="Artists · kkaraoke" description="Every artist in the karaoke catalog, A–Z.">
    <DesktopAppBar />
    <header class="border-b border-line">
        <div class="page-inner pt-[22px] pb-3 md:pt-7 md:pb-4">
            <div class="md:hidden">
                <BrandMark />
            </div>
            <h1 class="mt-3 text-[30px] font-bold tracking-[-0.025em] text-cream md:mt-0">Artists</h1>
        </div>
    </header>
    <main id="main" tabindex="-1" class="page-inner artist-index pb-6 md:pb-10">
        <nav class="artist-letter-nav col-span-full" aria-label="Jump to letter">
            {groups.map((group) => <a href={`#artist-letter-${group.letter}`}>{group.letter}</a>)}
        </nav>
        {
            groups.map((group) => (
                <section aria-labelledby={`artist-letter-${group.letter}`}>
                    <h2
                        id={`artist-letter-${group.letter}`}
                        class="artist-letter sticky top-0 z-10 bg-surface py-2.5 font-mono text-[11px] tracking-[0.16em] text-gold"
                    >
                        {group.letter}
                    </h2>
                    <ul class="m-0 list-none p-0">
                        {group.artists.map((artist) => {
                            const n = counts.get(artist.slug) ?? 0;
                            return (
                                <li>
                                    <a
                                        href={`/artists/${artist.slug}`}
                                        class="flex w-full items-center gap-3 border-b border-line px-0.5 py-3.5 text-left text-cream no-underline hover:text-cream"
                                    >
                                        <span class="flex-1 text-base">{artist.name}</span>
                                        <span class="artist-count hidden md:inline">
                                            {n} {n === 1 ? "song" : "songs"}
                                        </span>
                                        <span class="text-[15px] text-dim md:hidden" aria-hidden="true">
                                            →
                                        </span>
                                    </a>
                                </li>
                            );
                        })}
                    </ul>
                </section>
            ))
        }
    </main>
</Layout>
