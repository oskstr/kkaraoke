---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import { groupArtists } from "../../lib/catalogue";
import { getArtists } from "../../lib/songs";

const groups = groupArtists(getArtists());
---

<Layout title="Artists · kkaraoke">
    <header class="border-b border-[#1A1917] px-[18px] pt-[22px] pb-3" transition:name="page-header">
        <BackLink href="/" label="← BROWSE" />
        <h1 class="mt-3 text-[30px] font-bold tracking-[-0.025em] text-cream" transition:name="page-title">
            Artists
        </h1>
    </header>
    <main class="hd flex-1 overflow-y-auto px-[18px] pb-6" transition:animate="fade">
        {
            groups.map((group) => (
                <div>
                    <div class="sticky top-0 bg-surface py-2.5 font-mono text-[11px] tracking-[0.16em] text-gold">
                        {group.letter}
                    </div>
                    {group.artists.map((artist) => (
                        <a
                            href={`/artists/${artist.slug}`}
                            class="flex w-full items-center gap-3 border-b border-line px-0.5 py-3.5 text-left no-underline"
                            transition:name={`artist-${artist.slug}`}
                        >
                            <span class="flex-1 text-base text-cream">{artist.name}</span>
                            <span class="text-[15px] text-dim">→</span>
                        </a>
                    ))}
                </div>
            ))
        }
    </main>
</Layout>
