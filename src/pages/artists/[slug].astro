---
import Layout from "../../layouts/Layout.astro";
import BrandMark from "../../components/BrandMark.astro";
import SongList from "../../components/SongList.astro";
import { collectionPath, mergeSongVariants, sortSongVariants } from "../../lib/catalog";
import { getArtist, getArtists, getSongsByArtist } from "../../lib/songs";

export function getStaticPaths() {
    return getArtists().map((artist) => ({
        params: { slug: artist.slug },
        props: {
            artist,
            songs: sortSongVariants(mergeSongVariants(getSongsByArtist(artist.slug)), "az"),
        },
    }));
}

interface Props {
    artist: NonNullable<ReturnType<typeof getArtist>>;
    songs: ReturnType<typeof mergeSongVariants>;
}

const { artist, songs } = Astro.props;
---

<Layout title={`${artist.name} · kkaraoke`} description={artist.name}>
    <header class="border-b border-line px-[18px] pt-[22px] pb-[18px]">
        <BrandMark />
        <h1 class="artist-title mt-3 text-[34px] font-bold tracking-[-0.03em] text-pretty text-cream" data-artist-title>
            {artist.name}
        </h1>
        {
            artist.genres !== undefined && artist.genres.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                    {artist.genres.map((genre) => (
                        <a
                            href={collectionPath("genre", genre)}
                            class="rounded-full border border-line-strong px-2.5 py-1.5 font-mono text-[11px] tracking-wide text-cream-soft no-underline"
                        >
                            {genre}
                        </a>
                    ))}
                </div>
            )
        }
    </header>
    <main id="main" tabindex="-1" class="px-[18px] pt-1.5 pb-6">
        <SongList songs={songs} currentArtistSlug={artist.slug} />
    </main>
</Layout>
