---
import Layout from "../../layouts/Layout.astro";
import { getArtist, getArtists, getSongsByArtist } from "../../lib/songs";

export function getStaticPaths() {
    return getArtists().map((artist) => ({
        params: { slug: artist.slug },
        props: {
            artist,
            songs: getSongsByArtist(artist.slug),
        },
    }));
}

interface Props {
    artist: NonNullable<ReturnType<typeof getArtist>>;
    songs: ReturnType<typeof getSongsByArtist>;
}

const { artist, songs } = Astro.props;
---

<Layout title={`${artist.name} – KKaraoke`}>
    <main class="m-auto p-3 sm:p-6">
        <p class="mb-4">
            <a href="/" class="text-gray-600 underline-offset-2 hover:underline">← All songs</a>
        </p>
        <h1>{artist.name}</h1>
        {
            artist.genres !== undefined && artist.genres.length > 0 && (
                <p class="mt-2 text-gray-500">{artist.genres.join(", ")}</p>
            )
        }
        <p class="mt-2 text-sm text-gray-500">
            {songs.length} {songs.length === 1 ? "song" : "songs"}
        </p>

        <div class="mt-6 w-full overflow-x-auto">
            <table class="mx-auto w-full max-w-4xl">
                <thead class="border-b border-gray-200">
                    <tr>
                        <th class="px-3 py-2 text-left sm:px-6 sm:py-4">ID</th>
                        <th class="px-3 py-2 text-left sm:px-6 sm:py-4">Artist</th>
                        <th class="px-3 py-2 text-left sm:px-6 sm:py-4">Title</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        songs.map((song) => (
                            <tr class="border-b border-gray-200">
                                <td class="px-3 py-2 font-medium tabular-nums sm:px-6 sm:py-4">
                                    {song.id}
                                </td>
                                <td class="px-3 py-2 sm:px-6 sm:py-4">
                                    {/* Same linking rule as the main list: each credited
                                        name, including collab partners on this page. */}
                                    {song.artists !== undefined && song.artists.length > 0
                                        ? song.artists.map((credited, index) => (
                                              <>
                                                  {index > 0 && ", "}
                                                  {credited.mbid === artist.mbid ? (
                                                      <span>{credited.name}</span>
                                                  ) : (
                                                      <a
                                                          href={`/artists/${credited.slug}`}
                                                          class="underline-offset-2 hover:underline"
                                                      >
                                                          {credited.name}
                                                      </a>
                                                  )}
                                              </>
                                          ))
                                        : song.artist}
                                </td>
                                <td class="px-3 py-2 sm:px-6 sm:py-4">
                                    {song.song}
                                    {song.from !== undefined && (
                                        <span class="block text-sm text-gray-500">{song.from}</span>
                                    )}
                                    {song.category !== undefined && (
                                        <span class="block text-sm text-gray-500">{song.category}</span>
                                    )}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </main>
</Layout>
<style>
    h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0;
    }
</style>
