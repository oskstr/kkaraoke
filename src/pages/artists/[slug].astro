---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import SongList from "../../components/SongList.astro";
import { collectionPath, mergeSongVariants, sortSongVariants } from "../../lib/catalogue";
import { getArtist, getArtists, getSongsByArtist } from "../../lib/songs";

export function getStaticPaths() {
    return getArtists().map((artist) => ({
        params: { slug: artist.slug },
        props: {
            artist,
            songs: sortSongVariants(mergeSongVariants(getSongsByArtist(artist.slug)), "az"),
        },
    }));
}

interface Props {
    artist: NonNullable<ReturnType<typeof getArtist>>;
    songs: ReturnType<typeof mergeSongVariants>;
}

const { artist, songs } = Astro.props;
---

<Layout title={`${artist.name} · kkaraoke`}>
    <header class="border-b border-[#1A1917] px-[18px] pt-[22px] pb-[18px]">
        <BackLink href="/artists" label="← BACK" />
        <h1 class="mt-3 text-[34px] font-bold tracking-[-0.03em] text-cream text-pretty">
            {artist.name}
        </h1>
        {
            artist.genres !== undefined && artist.genres.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                    {artist.genres.map((genre) => (
                        <a
                            href={collectionPath("genre", genre)}
                            class="rounded-full border border-[#2F2C28] px-2.5 py-1.5 font-mono text-[11px] tracking-wide text-[#C6BDB1] no-underline"
                        >
                            {genre}
                        </a>
                    ))}
                </div>
            )
        }
    </header>
    <main class="px-[18px] pt-1.5 pb-6">
        <SongList songs={songs} currentArtistSlug={artist.slug} />
    </main>
</Layout>
