---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import FavoritesApp from "../components/FavoritesApp";
import { buildSearchIndex } from "../lib/catalogue";
import { getSongs } from "../lib/songs";

const songs = buildSearchIndex(getSongs());
---

<Layout title="Favorites · kkaraoke">
    <header class="border-b border-[#1A1917] px-[18px] pt-[22px] pb-4" transition:name="page-header">
        <BackLink href="/" label="← BROWSE" />
        <h1 class="mt-3 text-[30px] font-bold tracking-[-0.025em] text-cream" transition:name="page-title">
            Favorites
        </h1>
    </header>
    <main class="hd flex-1 overflow-y-auto px-[18px] pt-1.5 pb-6">
        <FavoritesApp client:load songs={songs} />
    </main>
</Layout>
