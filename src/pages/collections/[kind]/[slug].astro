---
import Layout from "../../../layouts/Layout.astro";
import BackLink from "../../../components/BackLink.astro";
import SortTabs from "../../../components/SortTabs.astro";
import SongList from "../../../components/SongList.astro";
import {
    collectionKinds,
    mergeSongVariants,
    resolveCollection,
    songsInCollection,
    sortSongVariants,
    type CollectionKind,
} from "../../../lib/catalogue";
import { getSongs, slugify } from "../../../lib/songs";

export function getStaticPaths() {
    const songs = getSongs();
    const paths: { params: { kind: string; slug: string } }[] = [];

    for (const kind of collectionKinds()) {
        const keys = new Set<string>();
        for (const song of songs) {
            if (kind === "decade" && song.year !== undefined) {
                keys.add(String(Math.floor(song.year / 10) * 10));
            } else if (kind === "genre") {
                for (const g of song.genres ?? []) keys.add(g);
            } else if (kind === "category" && song.category) {
                keys.add(song.category);
            } else if (kind === "from" && song.from) {
                keys.add(song.from);
            } else if (kind === "lang" && song.language) {
                keys.add(song.language);
            }
        }
        for (const key of keys) {
            paths.push({ params: { kind, slug: slugify(key) } });
        }
    }

    return paths;
}

const kind = Astro.params.kind as CollectionKind;
const slug = Astro.params.slug!;
const songs = getSongs();
const collection = resolveCollection(kind, slug, songs);

if (collection === undefined) {
    return Astro.redirect("/");
}

const rows = sortSongVariants(
    mergeSongVariants(songsInCollection(songs, collection.kind, collection.key)),
    "az",
);
const INITIAL = 80;
const CHUNK = 80;
const initialRows = rows.slice(0, INITIAL);
const moreRows = rows.slice(INITIAL).map((song) => ({
    id: song.id,
    ids: song.ids,
    title: song.song,
    artist: song.artist || song.category || "",
    year: song.year !== undefined ? String(song.year) : "",
    from: song.from ?? "",
    category: song.category ?? "",
    artists: (song.artists ?? []).map((a) => ({ name: a.name, slug: a.slug })),
}));

const backFallback: Record<CollectionKind, string> = {
    decade: "/browse/decades",
    genre: "/browse/genres",
    category: "/browse/categories",
    from: "/browse/films",
    lang: "/browse/languages",
};
---

<Layout title={`${collection.label} · kkaraoke`}>
    <!--
      One shared-element target for the tile morph: the whole tinted chrome
      (back + title + sort) so the tile color expands into the top bar.
    -->
    <div
        class="collection-chrome"
        style={`background:${collection.tint};border-bottom:1px solid rgba(0,0,0,0.25);view-transition-class:coll-chrome`}
        transition:name={collection.transitionName}
        transition:animate="initial"
    >
        <header class="px-[18px] pt-[22px] pb-0">
            <BackLink href={backFallback[collection.kind]} label="← BACK" light />
            <h1
                class="collection-title mt-3 mb-3.5 text-[34px] leading-none font-bold tracking-[-0.03em] text-[#FCFAF6] text-pretty"
                style="view-transition-class: coll-title"
                transition:name={collection.titleTransitionName}
                transition:animate="initial"
            >
                {collection.label}
            </h1>
        </header>
        <SortTabs />
    </div>
    <main class="hd min-h-0 flex-1 overflow-y-auto bg-surface px-[18px] pt-1.5 pb-6" data-scroll-root>
        <SongList songs={initialRows} sortable />
        {
            moreRows.length > 0 && (
                <div class="py-2" data-more-songs-root>
                    <script
                        is:inline
                        type="application/json"
                        data-more-songs
                        data-chunk={String(CHUNK)}
                        set:html={JSON.stringify(moreRows)}
                    />
                    <div data-infinite-sentinel class="h-8 w-full" aria-hidden="true" />
                </div>
            )
        }
    </main>
</Layout>

<script>
    type MoreSong = {
        id: number;
        ids: number[];
        title: string;
        artist: string;
        year: string;
        from: string;
        category: string;
        artists: { name: string; slug: string }[];
    };

    function rowHtml(song: MoreSong): string {
        const title = escapeHtml(song.title);
        const meta = [song.from, song.year].filter(Boolean);
        let subtitle = "";
        if (song.artists.length > 0) {
            subtitle = song.artists
                .map(
                    (a, i) =>
                        `${i > 0 ? ", " : ""}<a href="/artists/${escapeAttr(a.slug)}" class="text-muted no-underline hover:text-cream-soft">${escapeHtml(a.name)}</a>`,
                )
                .join("");
            if (meta.length > 0) subtitle += ` · ${escapeHtml(meta.join(" · "))}`;
        } else {
            const bits = [song.category, ...meta].filter(Boolean);
            subtitle = escapeHtml(bits.join(" · "));
        }
        const ids = song.ids.length > 0 ? song.ids : [song.id];
        const idsAttr = ids.join(",");
        const numbersLabel =
            ids.length === 1 ? `Number ${ids[0]}` : `Numbers ${ids.join(", ")}`;
        const numbers = ids.map((id) => `<span>${id}</span>`).join("");
        return `<div class="song-row flex items-start gap-2.5 border-b border-line py-3" data-title="${escapeAttr(song.title)}" data-artist="${escapeAttr(song.artist)}" data-year="${escapeAttr(song.year)}" data-id="${ids[0]}">
        <span class="song-num flex w-11 shrink-0 flex-col items-end gap-0.5 pt-1 font-mono text-[12px] tabular-nums leading-none text-gold" aria-label="${escapeAttr(numbersLabel)}">${numbers}</span>
        <div class="flex min-h-11 flex-1 flex-col justify-center">
          <div class="text-[15.5px] leading-snug text-cream">${title}</div>
          <div class="mt-0.5 text-[13px] text-muted">${subtitle}</div>
        </div>
        <button type="button" data-fav-toggle="${idsAttr}" class="min-w-11 self-center bg-transparent px-1 py-2.5 text-[17px]" style="border:0;color:#3B3733" aria-label="Add to favorites" aria-pressed="false">♥</button>
      </div>`;
    }

    function escapeHtml(value: string): string {
        return value
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;");
    }

    function escapeAttr(value: string): string {
        return escapeHtml(value).replaceAll("'", "&#39;");
    }

    let observer: IntersectionObserver | null = null;
    let loadMoreFn: (() => void) | null = null;
    let listEl: Element | null = null;

    function bindInfiniteScroll() {
        observer?.disconnect();
        observer = null;
        loadMoreFn = null;
        listEl = null;

        const root = document.querySelector("[data-more-songs-root]");
        const list = document.querySelector("[data-song-list]");
        const sentinel = document.querySelector("[data-infinite-sentinel]");
        const json = document.querySelector("[data-more-songs]");
        const scrollRoot = document.querySelector("[data-scroll-root]");
        if (!root || !list || !sentinel || !json) return;

        let remaining: MoreSong[] = [];
        try {
            remaining = JSON.parse(json.textContent || "[]") as MoreSong[];
        } catch {
            root.remove();
            return;
        }
        if (remaining.length === 0) {
            root.remove();
            return;
        }

        const chunk = Math.max(1, Number(json.getAttribute("data-chunk") || "80"));
        listEl = list;

        const loadMore = () => {
            if (remaining.length === 0) return;
            const batch = remaining.splice(0, chunk);
            list.insertAdjacentHTML("beforeend", batch.map(rowHtml).join(""));
            window.dispatchEvent(new Event("kkaraoke:favorites"));
            if (remaining.length === 0) {
                observer?.disconnect();
                observer = null;
                loadMoreFn = null;
                root.remove();
            }
        };
        loadMoreFn = loadMore;

        observer = new IntersectionObserver(
            (entries) => {
                if (entries.some((e) => e.isIntersecting)) loadMore();
            },
            {
                root: scrollRoot instanceof Element ? scrollRoot : null,
                rootMargin: "240px 0px",
                threshold: 0,
            },
        );
        observer.observe(sentinel);
    }

    function onEnsureScrollHeight(event: Event) {
        const detail = (event as CustomEvent<{ minHeight: number; root: HTMLElement }>).detail;
        if (!detail || !loadMoreFn || !listEl) return;
        // Grow the list until it can hold the restored scroll offset.
        let guard = 0;
        while (
            loadMoreFn &&
            detail.root.scrollHeight < detail.minHeight &&
            guard < 40
        ) {
            loadMoreFn();
            guard += 1;
        }
    }

    bindInfiniteScroll();
    document.addEventListener("astro:page-load", bindInfiniteScroll);
    document.addEventListener("kkaraoke:ensure-scroll-height", onEnsureScrollHeight);
</script>
