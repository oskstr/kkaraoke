---
import Layout from "../layouts/Layout.astro";
import { getSongs } from "../lib/songs";
import type { Song } from "../lib/songs";
import type { GetStaticPathsOptions, Page } from "astro";

export function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    return paginate(getSongs(), { pageSize: 50 });
}

interface Props {
    page: Page<Song>;
}

const { page } = Astro.props;
---

<Layout title="KKaraoke">
    <main class="m-auto p-3 sm:p-6">
        <h1>Welcome to <span class="text-gradient">KKaraoke</span></h1>
        <h1>Page {page.currentPage}</h1>
        <div class="flex justify-end gap-2">
            {page.url.prev && <a href={page.url.prev}>Prev</a>}
            {page.url.next && <a href={page.url.next}>Next</a>}
        </div>

        <!--
            Scrollable rather than centred: a flex-centred child that outgrows its parent
            overflows to the left as well as the right, and there is no scrolling back to
            reach it, which is how the ID column disappeared on a phone in portrait.
        -->
        <div class="w-full overflow-x-auto">
            <table class="mx-auto">
                <thead class="border-b border-gray-200">
                    <tr>
                        <th class="px-3 py-2 text-left sm:px-6 sm:py-4">ID</th>
                        <th class="px-3 py-2 text-left sm:px-6 sm:py-4">Artist</th>
                        <th class="px-3 py-2 text-left sm:px-6 sm:py-4">Title</th>
                        <th class="hidden px-3 py-2 text-left sm:table-cell sm:px-6 sm:py-4">Genre</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        page.data.map((song) => (
                            <tr class="border-b border-gray-200">
                                {/* The number people actually punch into the machine, so it
                                    stays on one line and never gets dropped for space. */}
                                <td class="px-3 py-2 font-medium tabular-nums sm:px-6 sm:py-4">{song.id}</td>
                                <td class="px-3 py-2 sm:px-6 sm:py-4">
                                    {/* Link from the id list, never by splitting the credit
                                        string — ampersands can be part of a name. */}
                                    {song.artists !== undefined && song.artists.length > 0
                                        ? song.artists.map((credited, index) => (
                                              <>
                                                  {index > 0 && ", "}
                                                  <a
                                                      href={`/artists/${credited.slug}`}
                                                      class="underline-offset-2 hover:underline"
                                                  >
                                                      {credited.name}
                                                  </a>
                                              </>
                                          ))
                                        : song.artist}
                                </td>
                                <td class="px-3 py-2 sm:px-6 sm:py-4">
                                    {song.song}
                                    {/* The show, for the songs the venue filed under one. Beside
                                        the title rather than in a column of its own, so that
                                        searching for Grease still finds these three songs. */}
                                    {song.from !== undefined && (
                                        <span class="block text-sm text-gray-500">{song.from}</span>
                                    )}
                                    {/* Traditional buckets (Christmas, birthday, hymns) live
                                        here rather than as invented performers in the artist
                                        column. */}
                                    {song.category !== undefined && (
                                        <span class="block text-sm text-gray-500">{song.category}</span>
                                    )}
                                </td>
                                {/* Genre is here to make bad data visible while the catalogue is
                                    being corrected, not as a finished column. The year is
                                    deliberately not shown: it is in the data to filter on later. */}
                                <td class="hidden px-3 py-2 text-sm text-gray-500 sm:table-cell sm:px-6 sm:py-4">
                                    {song.genres?.join(", ")}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </main>
</Layout>
<style>
    h1 {
        font-size: 3rem;
        font-weight: 800;
        margin: 0;
    }
    .text-gradient {
        background-image: var(--accent-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-size: 400%;
        background-position: 0%;
    }
</style>
