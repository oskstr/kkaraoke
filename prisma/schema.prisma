generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Pinned rather than inferred, so CI and Vercel generate byte-identical
  // output to a local `prisma generate`.
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model kkaraoke {
  id     Int    @id
  artist String
  song   String
}
